[Unit]
Description=AmarktAI Marketing FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/amarktai-marketing/repo/backend
EnvironmentFile=/var/www/amarktai-marketing/repo/backend/.env
ExecStart=/var/www/amarktai-marketing/repo/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
