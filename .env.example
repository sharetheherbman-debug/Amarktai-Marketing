# ═══════════════════════════════════════════
# AMarkTAI Marketing Platform - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git (already in .gitignore)
# ═══════════════════════════════════════════

# ─── TIER 1: PREMIUM (GenX) ───
GENX_API_KEY=your_genx_api_key_here
GENX_BASE_URL=https://api.genx.ai/v1

# ─── TIER 2: WORKHORSE (DeepInfra) ───
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ─── TIER 3: FREE (Together AI) ───
TOGETHER_API_KEY=your_together_api_key_here

# ─── DATABASE ───
DATABASE_URL=postgresql://amarktai:amarktai_secure_pass@postgres:5432/amarktai_mkt

# ─── APP SETTINGS ───
APP_NAME=AMarkTAI Studio
APP_DOMAIN=marketing.amarktai.co.za
LOG_LEVEL=info
