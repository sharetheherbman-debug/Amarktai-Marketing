# ═══════════════════════════════════════════
# AMarkTAI Marketing Platform - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════

# GenX Router API (single key for all 69 models)
GENX_API_KEY=gnxk_your_genx_key_here

# JWT Auth
JWT_SECRET=change_this_to_random_string
ADMIN_EMAIL=amarktainetwork@gmail.com
ADMIN_PASSWORD=your_admin_password

# Directus
DIRECTUS_KEY=change_this_directus_key
DIRECTUS_SECRET=change_this_directus_secret
DIRECTUS_ADMIN_PASS=AdminPass2026!

# App
APP_DOMAIN=marketing.amarktai.co.za
LOG_LEVEL=info
