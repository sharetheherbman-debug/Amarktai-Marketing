# ============================================
# AmarktAI Marketing - Environment Variables
# ============================================

# Application
APP_NAME="AmarktAI Marketing"
APP_VERSION="1.0.0"
DEBUG=false
FRONTEND_URL="https://marketing.amarktai.com"

# Admin email — this account always has unlimited access at zero cost.
# IMPORTANT: Override this if you are deploying a separate instance.
# The startup validator will warn in production if this is still the default.
ADMIN_EMAIL="amarktainetwork@gmail.com"

# ============================================
# AMARKTAI NETWORK INTEGRATION
# ============================================
# Per-app identity (set these for every deployed instance)
APP_ID="amarktai-marketing"
APP_SLUG="amarktai-marketing"
APP_ENVIRONMENT="production"   # production | staging | development

# Outbound connection to the AmarktAI Network main dashboard.
# AMARKTAI_INTEGRATION_TOKEN must be generated in the AmarktAI Network admin
# under Apps → Register App → Generate Token.  Keep it server-side ONLY.
AMARKTAI_DASHBOARD_URL="https://dashboard.amarktai.com"
AMARKTAI_INTEGRATION_TOKEN=""   # generated per-app token — NEVER expose to frontend
AMARKTAI_INTEGRATION_ENABLED=false   # set to true once token is configured

# Database (PostgreSQL is the canonical database for this project)
# Database (PostgreSQL)
DATABASE_URL="postgresql://amarktai:CHANGE_THIS_PASSWORD@localhost:5432/amarktai"

# Redis (for Celery and caching)
REDIS_URL="redis://localhost:6379"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# App-owned JWT Auth
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Encryption Key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY="your-encryption-key-here-change-in-production"

# ============================================
# AI CONTENT GENERATION — REQUIRED FOR LAUNCH
# ============================================
# GenX is the primary (and required) unified AI provider.
# All AI features — content generation, strategy, analysis — route through GenX.
# Get your API key from: https://genxai.co
GENX_API_KEY=""                          # REQUIRED — primary AI provider
GENX_BASE_URL="https://api.genxai.co/v1"
GENX_DEFAULT_MODEL="genx-chat-pro"
GENX_TIMEOUT=60
GENX_MODEL_ALLOWLIST=""        # optional: comma-separated list of allowed model IDs
GENX_MODEL_FALLBACKS=""        # optional: comma-separated ordered fallback model IDs
# Per-task model overrides (leave blank to use GENX_DEFAULT_MODEL for all tasks)
GENX_MODEL_COPY=""
GENX_MODEL_STRATEGY=""
GENX_MODEL_ANALYSIS=""
GENX_MODEL_LONG_FORM=""
GENX_MODEL_MODERATION=""

# ============================================
# LEGACY FALLBACK PROVIDERS (OPTIONAL)
# ============================================
# Used only when GenX is unavailable. Leave blank if not needed.

# Qwen (Alibaba Cloud DashScope) — secondary text-generation fallback
# Get key at: https://dashscope.aliyun.com/
QWEN_API_KEY=""
QWEN_MODEL="Qwen/Qwen2.5-72B-Instruct"

# HuggingFace Inference API — tertiary fallback (free tier available)
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=""

# ============================================
# AI CONTENT GENERATION — OPTIONAL INTERNAL FALLBACK
# ============================================
# OpenAI — optional compatibility fallback (not required for launch)
OPENAI_API_KEY=""

# Gemini (Google) — optional add-on
GEMINI_API_KEY=""

# ============================================
# IMAGE GENERATION API KEYS (OPTIONAL / DEFERRED)
# ============================================

# Leonardo.ai (Premium quality)
LEONARDO_API_KEY=""

# Midjourney (via API)
MIDJOURNEY_API_KEY=""

# Stability AI
STABILITY_API_KEY=""

# Replicate (Cheap alternative)
REPLICATE_API_TOKEN=""

# fal.ai (Fast generation)
FAL_AI_KEY=""

# SiliconFlow (Free tier)
SILICONFLOW_API_KEY=""

# ============================================
# VIDEO GENERATION API KEYS
# ============================================

# Runway ML (Premium video generation)
RUNWAY_API_KEY=""

# HeyGen (AI avatars)
HEYGEN_API_KEY=""

# Synthesia
SYNTHESIA_API_KEY=""

# ============================================
# AUDIO/Voice API KEYS
# ============================================

# ElevenLabs (Best quality voice)
ELEVENLABS_API_KEY=""

# Coqui TTS (FREE - Open source)
COQUI_API_KEY=""

# Play.ht
PLAYHT_API_KEY=""

# ============================================
# SOCIAL PLATFORM API KEYS (OAuth2)
# ============================================

# YouTube (Google Cloud Console)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# TikTok (TikTok for Developers)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_APP_ID=""

# Meta (Facebook Developers)
META_APP_ID=""
META_APP_SECRET=""
INSTAGRAM_CLIENT_ID="${META_APP_ID}"
INSTAGRAM_CLIENT_SECRET="${META_APP_SECRET}"
FACEBOOK_CLIENT_ID="${META_APP_ID}"
FACEBOOK_CLIENT_SECRET="${META_APP_SECRET}"

# Twitter/X (Twitter Developer Portal)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

# LinkedIn (LinkedIn Developers)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Pinterest (Pinterest Developers)
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# Reddit (reddit.com/prefs/apps)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="AmarktAIBot/1.0"

# Bluesky / AT Protocol (bsky.social app password)
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""

# Telegram (BotFather token + channel)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Snapchat (Snap Business Manager)
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# ============================================
# TREND DATA SOURCES
# ============================================

# Google Trends (via SerpAPI)
SERPAPI_KEY=""
GOOGLE_TRENDS_API_KEY=""

# News APIs
NEWSAPI_KEY=""
GNEWS_API_KEY=""

# ============================================
# WEB SCRAPING
# ============================================

# Firecrawl — primary scraping provider (JS-rendered, richer extraction)
# Get your key at: https://firecrawl.dev
# Falls back to httpx + BeautifulSoup when not set.
FIRECRAWL_API_KEY=""

# ============================================
# PAYMENTS — Stripe (active, required for paid plans)
# ============================================
# IMPORTANT: STRIPE_WEBHOOK_SECRET is required in production.
# Unsigned webhook payloads are rejected when APP_ENVIRONMENT=production.
# Register your webhook endpoint at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://yourdomain.com/api/v1/billing/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""    # REQUIRED in production — unsigned webhooks are rejected
STRIPE_PRICE_ID_FREE=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""
STRIPE_PRICE_ID_ENTERPRISE=""

# ============================================
# EMAIL
# ============================================

# Resend
RESEND_API_KEY=""
FROM_EMAIL="noreply@amarktai.com"
# Destination address for contact form submissions
CONTACT_EMAIL=""

# Brevo (Sendinblue) - Alternative
BREVO_API_KEY=""

# ============================================
# STORAGE
# ============================================

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="amarktai-media"
AWS_REGION="us-east-1"

# ============================================
# MONITORING
# ============================================

# Sentry
SENTRY_DSN=""

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_AUTO_POST=false
ENABLE_AUTO_REPLY=false
ENABLE_AB_TESTING=true
ENABLE_VIRAL_PREDICTION=true
ENABLE_COST_TRACKING=true

# ============================================
# RATE LIMITS
# ============================================

MAX_CONTENT_PER_DAY=10
MAX_ENGAGEMENT_REPLIES_PER_DAY=50
MAX_MEDIA_GENERATIONS_PER_DAY=20
